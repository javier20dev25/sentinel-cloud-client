  "description": "Authenticated client for the Sentinel Cloud API. Protocol and transport only: it contains no detection engine, no rules, and no proprietary scanner logic.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "sentinel",
    "security",
    "sast",
    "supply-chain"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sentinel-security/cloud-client.git"
  },
  "dependencies": {},
